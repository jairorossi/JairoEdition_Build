<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!-- Remove compiladores e emuladores redundantes do macOS (Darwin) e outros, poupando 20GB+ e milhoes de inodes -->
  <remove-project name="platform/prebuilts/clang/host/darwin-x86" />
  <remove-project name="platform/prebuilts/android-emulator" />
  <remove-project name="platform/prebuilts/jdk/jdk8/darwin-x86" />
  <remove-project name="platform/prebuilts/jdk/jdk9/darwin-x86" />
  <remove-project name="platform/prebuilts/jdk/jdk11/darwin-x86" />

  <!-- Repositorios oficiais do Penglezos e TheMuppets para o Raphael (A14) -->
  <project name="penglezos/device_xiaomi_raphael" path="device/xiaomi/raphael" remote="github" revision="lineage-21.0" />
  <project name="penglezos/kernel_xiaomi_raphael" path="kernel/xiaomi/raphael" remote="github" revision="lineage-21.0" />
  <project name="TheMuppets/proprietary_vendor_xiaomi_raphael" path="vendor/xiaomi/raphael" remote="github" revision="lineage-21" />

  <!-- Dependencia de hardware comum da Xiaomi -->
  <project name="LineageOS/android_hardware_xiaomi" path="hardware/xiaomi" remote="github" revision="lineage-21.0" />

  <!-- Port oficial da Câmera Leica/MIUI adaptada para Android 14 AOSP -->
  <project name="ArianK16a/android_vendor_xiaomi_camera" path="vendor/xiaomi/camera" remote="github" revision="lineage-21" />
</manifest>
